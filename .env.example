# Copy to .env.development (local) or .env.production (deployed), then fill in.
# Vite only exposes variables prefixed VITE_ to the browser bundle.

# Backend origin. Leave EMPTY for local dev — the Vite dev server proxies
# /api and /media to http://localhost:8000 (see vite.config.ts), so requests
# can stay same-origin and cookie/CORS-simple during development.
#
# In production this MUST be set, since the frontend and backend are two
# separate deployments on two different domains:
#   VITE_API_URL=https://chrisjames-backend.vercel.app
VITE_API_URL=
