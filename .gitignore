coverage/

# Temporary files
tmp/
temp/

# Ignore files ending with underscore + numbers
*_[0-9].*
*_[0-9][0-9]*.*

# Ignore underscore-prefixed directories everywhere
_*/
**/_*/

# Examples:
*.zip
_backup/
# src/_old/
# components/_drafts/

